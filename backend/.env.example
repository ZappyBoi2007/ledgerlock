# ─────────────────────────────────────────────────────────────────────────────
# LedgerLock – Backend Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER put real secrets, private keys, or passwords in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (if used) ───────────────────────────────────────────────────────
DATABASE_URL=

# ── Blockchain / RPC ─────────────────────────────────────────────────────────
# e.g. Infura / Alchemy endpoint for the target network
RPC_URL=
CHAIN_ID=
# Private key of the backend signing wallet — NEVER commit a real key
BLOCKCHAIN_PRIVATE_KEY=

# ── Smart Contract ───────────────────────────────────────────────────────────
CONTRACT_ADDRESS=

# ── IPFS / Pinata ────────────────────────────────────────────────────────────
# JWT token from your Pinata account → API Keys → Generate JWT
PINATA_JWT=
# Your dedicated Pinata gateway base URL, e.g. https://myapp.mypinata.cloud
PINATA_GATEWAY=https://gateway.pinata.cloud
# Pinata upload API endpoint (override only for testing/staging)
PINATA_API_URL=https://uploads.pinata.cloud/v3/files

# ── Auth / JWT (to be configured later) ──────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
