# ─────────────────────────────────────────────────────────────────────────────
# LedgerLock – Backend Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER put real secrets, private keys, or passwords in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (if used) ───────────────────────────────────────────────────────
DATABASE_URL=

# ── Blockchain / RPC ─────────────────────────────────────────────────────────
# e.g. Infura / Alchemy endpoint for the target network
RPC_URL=
CHAIN_ID=

# ── Smart Contract ───────────────────────────────────────────────────────────
CONTRACT_ADDRESS=

# ── IPFS / Pinata (to be configured later) ───────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY_URL=

# ── Auth / JWT (to be configured later) ──────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
